# .env.example

This file provides the base configuration contract for local development.
Do not add real secrets to version control.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_studios
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_studios
QUEUE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_studios_queue

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

YOUTUBE_API_KEY=replace-with-youtube-api-key
ENCRYPTION_KEY=replace-with-32-byte-secret-key

AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
